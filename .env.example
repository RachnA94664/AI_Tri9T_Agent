# Copy this file to .env and fill in real values. .env is ignored by git.
# NEVER put a real key in this example file.

OPENAI_API_KEY=your-key-here
OPENAI_MODEL=gpt-4o-mini
DATABASE_URL=sqlite:///./knowledge.db
# Comma-separated list of allowed frontend origins (no trailing slash)
ALLOWED_ORIGINS=http://localhost:5173
